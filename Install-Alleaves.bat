@echo off
setlocal enableextensions
REM ===================================================================
REM  Install-Alleaves.bat - GENERATED by build-bat.ps1. Do not edit by
REM  hand; edit alleaves_setup.ps1 and rebuild.
REM  Double-click = install.  "-Uninstall" = reverse.  "-DryRun" = test.
REM ===================================================================

REM --- Single elevation owner: probe elevated-integrity SID, relaunch once.
REM  BOTH SIDs: 12288 is High, 16384 is SYSTEM - strictly higher, and the exact RMM
REM  case the .ps1 anticipates with its "service-account" precheck verdict. Matching
REM  High alone made a SYSTEM-dispatched run fail the probe and RunAs itself; SYSTEM's
REM  token is already elevated so no UAC gate stops it, and the child failed the same
REM  probe and spawned another - an unbounded, mutually-waiting fork chain, with the
REM  exit-8 verdict for that account never reaching the operator.
REM  FULL PATH, never a bare "whoami": the name is resolved through PATH, and a
REM  git-bash / MSYS / Cygwin shell puts its own GNU whoami first - which rejects
REM  /groups, exits 1, and reads as "not elevated". The relaunch then inherits the
REM  same PATH, the child fails identically, and it forks unboundedly: one UAC
REM  prompt per iteration, hundreds deep. Same fork chain as the SYSTEM case above,
REM  reached through a shadowed command name instead of an already-elevated token.
set "WHOAMI=%SystemRoot%\System32\whoami.exe"
if not exist "%WHOAMI%" goto :probefail
"%WHOAMI%" /groups | findstr /c:"S-1-16-12288" /c:"S-1-16-16384" >nul 2>&1
if not errorlevel 1 goto :elevated
REM  Second probe = the fork guard. A WORKING whoami always prints a mandatory-label
REM  SID (S-1-16-*); no label at all means the probe is broken, not that the token is
REM  unelevated. Relaunching on a broken probe is exactly what forks, so abort instead.
"%WHOAMI%" /groups | findstr /c:"S-1-16-" >nul 2>&1
if errorlevel 1 goto :probefail
echo Requesting administrator elevation...
REM F21: -Wait -PassThru so the non-elevated launcher waits for the elevated child
REM and propagates its real exit code. The "exit /b %ERRORLEVEL%" below MUST stay
REM OUTSIDE any ( ) block: inside a parenthesized block cmd freezes %ERRORLEVEL% at
REM parse time to the find result (=1), which would report a successful install as
REM failure. This relaunch is INTERACTIVE-only: ALLEAVES_NOPAUSE is not forwarded
REM across the UAC boundary, so RMM/unattended MUST invoke the .bat already-elevated.
if "%~1"=="" (
  powershell -NoProfile -Command "exit (Start-Process -FilePath '%~f0' -Verb RunAs -Wait -PassThru).ExitCode"
) else (
  powershell -NoProfile -Command "exit (Start-Process -FilePath '%~f0' -ArgumentList '%*' -Verb RunAs -Wait -PassThru).ExitCode"
)
exit /b %ERRORLEVEL%

:probefail
echo [FAIL] Cannot determine this token's integrity level - refusing to relaunch.
echo        %SystemRoot%\System32\whoami.exe did not report a mandatory-label SID.
echo        Run Install-Alleaves.bat from cmd.exe or Explorer, not from a bash/MSYS
echo        shell - relaunching on an unreadable probe forks without bound.
exit /b 3

:elevated

REM --- Record requested mode so the .ps1 can refuse a dropped -Uninstall.
set "ALLEAVES_REQUESTED_MODE=install"
echo %*| find /i "-uninstall" >nul 2>&1 && set "ALLEAVES_REQUESTED_MODE=uninstall"
echo Mode: %ALLEAVES_REQUESTED_MODE%

REM --- Force 64-bit PowerShell (Sysnative when launched from a 32-bit shell).
