REM --- Decode the base64 file back to the original .ps1 bytes.
"%PS%" -NoProfile -Command "[IO.File]::WriteAllBytes($env:TEMP+'\alleaves_setup.ps1',[Convert]::FromBase64String([IO.File]::ReadAllText($env:TEMP+'\alleaves_b64.txt')))"
if not exist "%TEMP%\alleaves_setup.ps1" (
  echo FATAL: decode failed - PowerShell could not write the script.
  del /f /q "%TEMP%\alleaves_b64.txt" >nul 2>&1
  pause
  exit /b 9
)

REM --- Run synchronously in this elevated console; propagate exit code.
REM  Note: -ExecutionPolicy Bypass loses to an AllSigned/Restricted GPO;
REM  if that bites on a managed fleet, switch to piping via -EncodedCommand.
REM  F25: %* forwards all args in one expansion. QUOTE any -SkipPrograms regex
REM  containing cmd metacharacters (| ^ & < >), e.g. -SkipPrograms "Chrome|NiceLabel"
REM  - unquoted metacharacters are interpreted by cmd and get mangled. Callers
REM  needing exotic regexes should invoke alleaves_setup.ps1 directly.
"%PS%" -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\alleaves_setup.ps1" %*
